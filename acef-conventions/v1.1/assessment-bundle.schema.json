{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acef.ai/schemas/v1.1/assessment-bundle.schema.json",
  "title": "ACEF Assessment Bundle (v1.1)",
  "description": "v1.1 extension of the v1.0 Assessment Bundle schema. Adds an OPTIONAL top-level field group 'coverage_cells' (plural array — multiple cells per assessment per brief §16.4 'Coverage Ledger'). Each coverage_cell describes 'for this subject, across this set of scenarios, within this time window, the bound evidence is fresh and covers the cell' per brief freddy-on-acef-requirements-v0.1.md §3.5. No standalone coverage_cell.schema.json file exists in v1.1/ — coverage_cell is defined inline here as an optional field group per VAL-SCHEMA-006. All v1.0 fields are preserved unchanged; v1.0 bundles remain valid against this schema (additive extension). Banned claim_language substrings (e.g. 'compliant', 'certified', 'AI Act-approved', 'guaranteed') are enforced at the validator level (ACEF-079 per VAL-VALIDATION-008), not by the schema.",
  "type": "object",
  "required": [
    "versioning",
    "assessment_id",
    "timestamp",
    "evaluation_instant",
    "assessor",
    "evidence_bundle_ref",
    "profiles_evaluated",
    "template_digests",
    "results",
    "provision_summary",
    "structural_errors",
    "integrity"
  ],
  "properties": {
    "versioning": {
      "type": "object",
      "description": "Module version declarations. Assessment Bundles declare core_version and assessment_version.",
      "required": ["core_version", "assessment_version"],
      "properties": {
        "core_version": {
          "type": "string",
          "description": "ACEF Core module version (semver).",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "assessment_version": {
          "type": "string",
          "description": "ACEF Assessment module version (semver).",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "assessment_id": {
      "type": "string",
      "description": "URN identifier for this assessment (urn:acef:asx:<uuid>).",
      "pattern": "^urn:acef:asx:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "description": "When this assessment was created (ISO 8601).",
      "format": "date-time"
    },
    "evaluation_instant": {
      "type": "string",
      "description": "The single reference time for all date-sensitive rule logic. Set by the validator at the start of evaluation. All rules using validation_time resolve to this value. Ensures reproducible evaluation.",
      "format": "date-time"
    },
    "assessor": {
      "type": "object",
      "description": "Tool or entity that performed the assessment.",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "organization": {"type": "string"}
      },
      "additionalProperties": true
    },
    "evidence_bundle_ref": {
      "type": "object",
      "description": "Reference to the Evidence Bundle being assessed.",
      "required": ["content_hash", "package_id"],
      "properties": {
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "package_id": {
          "type": "string",
          "pattern": "^urn:acef:pkg:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "additionalProperties": true
    },
    "profiles_evaluated": {
      "type": "array",
      "items": {"type": "string"}
    },
    "template_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "provision_id", "profile_id", "rule_severity", "outcome"],
        "properties": {
          "rule_id": {"type": "string"},
          "provision_id": {"type": "string"},
          "profile_id": {"type": "string"},
          "rule_severity": {
            "type": "string",
            "enum": ["fail", "warning", "info"]
          },
          "outcome": {
            "type": "string",
            "enum": ["passed", "failed", "skipped", "error"]
          },
          "message": {"type": ["string", "null"]},
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^urn:acef:rec:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "subject_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^urn:acef:sub:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "provision_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provision_id", "profile_id", "provision_outcome"],
        "properties": {
          "provision_id": {"type": "string"},
          "profile_id": {"type": "string"},
          "provision_outcome": {
            "type": "string",
            "enum": ["satisfied", "partially-satisfied", "not-satisfied", "not-assessed", "skipped", "gap-acknowledged"]
          },
          "subject_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^urn:acef:sub:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "fail_count": {"type": "integer", "minimum": 0},
          "warning_count": {"type": "integer", "minimum": 0},
          "skipped_count": {"type": "integer", "minimum": 0},
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^urn:acef:rec:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "structural_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^ACEF-[0-9]{3}$"
          },
          "severity": {
            "type": "string",
            "enum": ["fatal", "error", "warning", "info"]
          },
          "message": {"type": "string"},
          "path": {"type": "string"},
          "context": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "integrity": {
      "description": "JWS signature over the Assessment Bundle. Set to null before signing; populated after signing. Always present in the JSON structure (never removed).",
      "oneOf": [
        {
          "type": "object",
          "required": ["signature"],
          "properties": {
            "signature": {
              "type": "object",
              "required": ["method", "signer", "value"],
              "properties": {
                "method": {
                  "type": "string",
                  "const": "jws"
                },
                "signer": {"type": "string"},
                "value": {"type": "string"}
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage_cells": {
      "type": "array",
      "description": "NEW IN v1.1 — Optional array of coverage cells per brief §3.5 / §16.1 (Coverage Cell Model) / §16.4 (Coverage Ledger). Each cell describes 'for this subject, across this scenario class and surface class, within this time window, the bound evidence is fresh and covers the cell'. The plural-array shape is chosen because Assessment Bundles routinely roll up many cells per assessment (one per scenario_class × surface_class slice). NOT in top-level required — coverage_cells is optional for backward compatibility with v1.0 Assessment Bundles. No standalone coverage_cell.schema.json file exists in v1.1/ — coverage_cell is defined inline here per VAL-SCHEMA-006.",
      "items": {
        "type": "object",
        "title": "ACEF Coverage Cell",
        "description": "A single coverage cell entry per brief §3.5.",
        "required": [
          "cell_id",
          "subject_ref",
          "dimensions",
          "bound_evidence_refs",
          "freshness_state",
          "freshness_policy_ref",
          "claim_language",
          "coverage_outcome"
        ],
        "properties": {
          "cell_id": {
            "type": "string",
            "pattern": "^urn:acef:cell:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "description": "URN identifier for this coverage cell."
          },
          "subject_ref": {
            "type": "string",
            "description": "URN of the subject the cell is about."
          },
          "dimensions": {
            "type": "object",
            "description": "The cell's location in the coverage grid.",
            "required": ["scenario_class", "surface_class", "time_window_start", "time_window_end"],
            "properties": {
              "scenario_class": {"type": "string"},
              "surface_class": {"type": "string"},
              "time_window_start": {"type": "string", "format": "date-time"},
              "time_window_end": {"type": "string", "format": "date-time"}
            },
            "additionalProperties": true
          },
          "bound_evidence_refs": {
            "type": "array",
            "description": "Array of URNs of records the cell depends on.",
            "items": {"type": "string"}
          },
          "freshness_state": {
            "type": "string",
            "enum": ["fresh", "stale_within_grace", "stale_outside_grace", "unverified"],
            "description": "Freshness classification per the bound freshness policy."
          },
          "freshness_policy_ref": {
            "type": "string",
            "description": "URN of the freshness policy that classified the state."
          },
          "claim_language": {
            "type": "string",
            "description": "Constrained natural-language claim attached to the cell. Banned substrings ('compliant', 'certified', 'AI Act-approved', 'guaranteed') are enforced at the validator level (ACEF-079 per VAL-VALIDATION-008), not by the schema."
          },
          "coverage_outcome": {
            "type": "string",
            "enum": ["covered", "gap", "blocked"]
          },
          "blocker_ref": {
            "type": "string",
            "description": "URN of a coverage_blocker record. REQUIRED when coverage_outcome='blocked' (see allOf below)."
          }
        },
        "allOf": [
          {
            "description": "blocker_ref is required when coverage_outcome is 'blocked' per brief §3.5.",
            "if": {
              "type": "object",
              "properties": {"coverage_outcome": {"const": "blocked"}},
              "required": ["coverage_outcome"]
            },
            "then": {
              "required": ["blocker_ref"]
            }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
